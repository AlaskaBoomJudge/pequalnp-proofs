  refine ⟨({ gates := [{ op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [0, 4] }, { op := PEqualNP.CircuitLowerBounds.GateOp.and, inputs := [6, 2] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [7, 1] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [8, 3] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [9, 5] }, { op := PEqualNP.CircuitLowerBounds.GateOp.and, inputs := [3, 6] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [11, 5] }, { op := PEqualNP.CircuitLowerBounds.GateOp.not, inputs := [12] }, { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [13, 0] }, { op := PEqualNP.CircuitLowerBounds.GateOp.and, inputs := [14, 10] }], output := 15 } : PEqualNP.CircuitLowerBounds.Circuit), ?_, by decide, ?_⟩
  · intro g hg
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp
  · decide +kernel
